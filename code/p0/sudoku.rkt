;; testing
(module+ test

  ;; From The Guardian, 5 February 2026
  (define puzzle #<<EOS
...|...|...
...|.53|.24
...|24.|57.
---|---|---
..3|...|.9.
.79|..5|.8.
.1.|.7.|..6
---|---|---
..7|...|3..
.41|38.|..7
.6.|..4|.1.
EOS
    )

  (with-output-to-file
    "guardian.cnf"
    (λ ()
      (let* ([props (call-with-input-string puzzle read-puzzle)]
             [cnf   (sudoku-cnf props)])
        (write-cnf-as-dimacs cnf)))
    #:exists 'replace)

  ;; Now at the shell do `kissat -q guardian.cnf > guardian.soln`


  
  (display
   (puzzle-format
    (call-with-input-file
      "guardian.soln"
      read-kissat)))
  
  )

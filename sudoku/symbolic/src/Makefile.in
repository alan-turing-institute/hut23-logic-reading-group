		-rm -f ./$(DEPDIR)/___libsymbolic_a-approximate.Po
	-rm -f ./$(DEPDIR)/___libsymbolic_a-convert.Po
	-rm -f ./$(DEPDIR)/___libsymbolic_a-extract.Po

	$(AM_V_at)$(RANLIB) ../libsymbolic.a

../symbolic$(EXEEXT): $(___symbolic_OBJECTS) $(___symbolic_DEPENDENCIES) $(EXTRA____symbolic_DEPENDENCIES) ../$(am__dirstamp)
	@rm -f ../symbolic$(EXEEXT)
	$(AM_V_CCLD)$(LINK) $(___symbolic_OBJECTS) $(___symbolic_LDADD) $(LIBS)

